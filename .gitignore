# OS / editor
.DS_Store
*.swp

# local Caddy state (if ever run rootless locally)
caddy_data/
caddy_config/

# deploy-time secrets / local env (should never exist, but guard anyway)
.env
*.local

# deploy target (holds the internal Docker-host hostname) — never commit
platform/deploy.env

# Build-synced content: shared/{css,fonts} and shared/legal are mirrored into the
# site roots at deploy time (platform/deploy.sh). Source of truth lives in shared/.
sites/*/css/
sites/*/fonts/
sites/www/impressum/
sites/www/datenschutz/
sites/*/favicon.svg
# … außer site-eigene Favicons (maclist bringt sein App-Icon mit, sync-content.sh
# überschreibt es nicht — siehe dortige Favicon-Schleife)
!sites/maclist/favicon.svg

# Worker deploy config (contains account_id)
platform/worker/wrangler.toml

# Claude Code: lokale Einstellungen bleiben lokal (Hooks kommen beim Install zurueck).
.claude/settings.local.json
# impeccable-Engine: plattformspezifisches Binary (12 MB, darwin-arm64), wird von
# `npx impeccable install/update` geholt. Gehoert nicht in ein oeffentliches Repo.
.claude/skills/impeccable/scripts/bin/
# impeccable-Arbeitsstand: Referenz-Crops und Zwischenaufnahmen sind reproduzierbar
sites/*/.impeccable/build/crops/
sites/*/.impeccable/review/
